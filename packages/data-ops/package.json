{
  "name": "@repo/data-ops",
  "version": "1.0.0",
  "type": "module",
  "description": "Manage auth, database, schemas, and queries",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth/*": {
      "types": "./dist/auth/*.d.ts",
      "default": "./dist/auth/*.js"
    },
    "./database/*": {
      "types": "./dist/database/*.d.ts",
      "default": "./dist/database/*.js"
    },
    "./drizzle/*": {
      "types": "./dist/drizzle/*.d.ts",
      "default": "./dist/drizzle/*.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./schema/*": {
      "types": "./dist/schema/*.d.ts",
      "default": "./dist/schema/*.js"
    },
    "./queries/*": {
      "types": "./dist/queries/*.d.ts",
      "default": "./dist/queries/*.js"
    },
    "./hosting": {
      "types": "./dist/hosting/index.d.ts",
      "default": "./dist/hosting/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --outDir ./dist && tsc-alias",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "better-auth:generate": "mkdir -p src/drizzle && npx @better-auth/cli@latest generate --config ./config/auth.ts --output ./src/drizzle/auth-schema.ts",
    "drizzle:generate": "drizzle-kit generate --config drizzle.config.ts",
    "drizzle:migrate": "pnpm wrangler --config ../../apps/user-application/wrangler.jsonc d1 migrations apply sec-db --local",
    "drizzle:migrate:prod": "wrangler --config ../../apps/user-application/wrangler.jsonc d1 migrations apply sec-db --remote",
    "drizzle:pull": "drizzle-kit pull --config drizzle.config.ts",
    "drizzle:studio": "drizzle-kit studio --config drizzle.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@paralleldrive/cuid2": "^2.2.2",
    "@repo/contracts": "workspace:*",
    "@repo/logger": "workspace:*",
    "better-auth": "^1.3.7",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.5",
    "drizzle-zod": "^0.8.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250823.0",
    "@types/better-sqlite3": "^7.6.13",
    "@vitest/ui": "^4.0.6",
    "drizzle-kit": "^0.31.5",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.2",
    "vite": "^7.1.12",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.6"
  }
}
