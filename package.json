{
  "name": "openscan",
  "version": "1.0.0",
  "description": "OpenScan - Open Source Security Scanner Platform",
  "scripts": {
    "setup": "pnpm i && pnpm run build:data-ops",
    "build:data-ops": "pnpm run --filter data-ops build",
    "dev:user-application": "pnpm run --filter user-application dev",
    "deploy:user-application": "VITE_BUILD_VERSION=$(git rev-parse --short HEAD) pnpm run build:data-ops && VITE_BUILD_VERSION=$(git rev-parse --short HEAD) pnpm run --filter user-application deploy",
    "deploy:data-service": "pnpm run --filter data-service deploy",
    "deploy:screenshot-worker": "pnpm run --filter screenshot-worker deploy",
    "dev:worker": "pnpm run --filter restate-worker dev",
    "build:worker": "pnpm run --filter restate-worker build",
    "start:worker": "pnpm run --filter restate-worker start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.8",
      "@types/react-dom": "^19.0.3"
    }
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "superjson": "^2.2.5",
    "zod": "^3.23.8"
  }
}
