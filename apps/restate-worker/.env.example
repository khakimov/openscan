# Restate Worker Configuration
# This worker handles port scanning and discovery workflows

# =============================================================================
# Server Configuration
# =============================================================================

# Port for the worker to listen on (default: 9080)
# This is the port Restate will connect to for service registration
RESTATE_PORT=9080

# Identity keys from Restate Cloud (optional, for production security)
# Get from: https://cloud.restate.dev/developers/integration
# Comma-separated if multiple keys
# Used to validate that requests are coming from your Restate Cloud instance
RESTATE_IDENTITY_KEYS=publickeyv1_GitE5st9nWD6zzXtXP4jjuB7BspSBiKGHNbRuM4TmbCz

# =============================================================================
# Postback Authentication
# =============================================================================

# API key for authenticating postback requests to the main application
# This MUST match the WORKER_API_KEY in your user-application .env
# Used when posting scan results to /api/internal/scan-results
# Generate with: openssl rand -base64 32
WORKER_API_KEY=your-secret-api-key-here

# =============================================================================
# Restate Configuration
# =============================================================================

# Restate admin API URL (for deployment status checks)
# Local: http://localhost:8080
# Restate Cloud: https://201k7hktgm99xk9cb3f5btv7x9w.env.us.restate.cloud
# Used by deployment checker to verify worker registration
RESTATE_ADMIN_URL=http://localhost:8080

# Restate API key (optional, for Restate Cloud authentication)
# Get from: https://cloud.restate.dev → Settings → API Keys
# Only needed if your admin API requires authentication
# RESTATE_API_KEY=your-api-key-here

# Restate ingress URL (used by the user-application HTTP client)
# Local: http://localhost:8080
# Restate Cloud: https://201k7hktgm99xk9cb3f5btv7x9w.env.us.restate.cloud
# Note: This is typically set in user-application .env, not here
# RESTATE_INGRESS_URL=http://localhost:8080

# =============================================================================
# Scanner Configuration
# =============================================================================

# Enable/disable individual scanners (default: disabled for safety)
# Nmap is always enabled (required for service detection)
SCANNER_ENABLE_MASSCAN=false
SCANNER_ENABLE_RUSTSCAN=false

# Dev mode: Return mock data instead of running actual scanners
# Useful for testing without scanner binaries installed
SCANNER_DEV_MODE=false

# Scanner binary paths (optional if in PATH)
# MASSCAN_PATH=/usr/local/bin/masscan
# RUSTSCAN_PATH=/usr/local/bin/rustscan

# Masscan configuration
MASSCAN_RATE=1000              # Packets per second (default: 1000)
MASSCAN_PORT_RANGE=1-1024      # Default port range if not specified
MASSCAN_TIMEOUT_MS=120000      # 2 minutes

# Rustscan configuration
RUSTSCAN_ULIMIT=6500           # Open file limit (default: 6500)
RUSTSCAN_TIMEOUT_MS=300000     # 5 minutes
RUSTSCAN_SOCKET_TIMEOUT_MS=1500  # Per-port timeout

# =============================================================================
# System Requirements
# =============================================================================
#
# The following must be installed on the system:
#
# Required:
# - nmap (for port scanning and service detection)
#     macOS: brew install nmap
#     Ubuntu: apt-get install nmap
#     Verify: which nmap
#
# - Node.js 18+ (for running the worker)
#
# Optional (for multi-scanner orchestration):
# - masscan (fast TCP port scanner)
#     macOS: brew install masscan
#     Ubuntu: apt-get install masscan
#     Verify: which masscan
#     Enable: Set SCANNER_ENABLE_MASSCAN=true
#
# - rustscan (fast port scanner with nmap integration)
#     Install: cargo install rustscan
#     Verify: which rustscan
#     Enable: Set SCANNER_ENABLE_RUSTSCAN=true
#
# - Docker (optional, for running Restate locally)
#
