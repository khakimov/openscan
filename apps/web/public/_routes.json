{
  "version": 1,
  "description": "Cloudflare Pages routing rules - exclude static assets from worker",
  "include": [
    "/*"
  ],
  "exclude": [
    "/*.png",
    "/*.jpg",
    "/*.jpeg",
    "/*.gif",
    "/*.webp",
    "/*.svg",
    "/*.ico",
    "/*.woff",
    "/*.woff2",
    "/*.ttf",
    "/*.eot",
    "/fonts/*",
    "/robots.txt",
    "/manifest.json",
    "/site.webmanifest",
    "/sitemap.xml",
    "/favicon.svg",
    "/favicon.ico",
    "/apple-touch-icon.png",
    "/docs/*",
    "/*.css",
    "/*.js",
    "/*.map",
    "/*.webmanifest",
    "/*.xml"
  ]
}
