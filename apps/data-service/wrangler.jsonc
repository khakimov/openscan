{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "data-service",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sec-db",
      "database_id": "93d2bd33-3b3e-42f3-a982-39b790922949",
      "preview_database_id": "test-sec-db",
      "migrations_dir": "../../packages/data-ops/migrations"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "notification-delivery",
        "max_batch_size": 10
      }
    ],
    "producers": [
      {
        "queue": "notification-delivery",
        "binding": "NOTIFICATION_DELIVERY_PRODUCER"
      }
    ]
  }
}
