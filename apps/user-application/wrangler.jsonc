{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sec-rocks",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "vars": {
    "TEMPORAL_HTTP_API_URL": "https://necto.sec.rocks",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sec-db",
      "database_id": "93d2bd33-3b3e-42f3-a982-39b790922949",
      "migrations_dir": "../../packages/data-ops/migrations",
    },
  ],
}
