# Local development environment variables for Cloudflare Workers
# Copy this to .dev.vars and fill in the actual values from Cloudflare Dashboard
#
# To get values:
# 1. Visit: https://dash.cloudflare.com
# 2. Go to: Workers & Pages → sec-rocks → Settings → Variables
# 3. Click "Edit variables" to reveal encrypted values
# 4. Copy each value here

# =============================================================================
# Authentication (Better Auth)
# =============================================================================
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=<get-from-cloudflare-dashboard>

# =============================================================================
# Google OAuth (Better Auth Social Login)
# =============================================================================
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=<get-from-cloudflare-dashboard>
GOOGLE_CLIENT_SECRET=<get-from-cloudflare-dashboard>
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# =============================================================================
# Session Management
# =============================================================================
# Generate with: openssl rand -base64 32
SESSION_SECRET=<get-from-cloudflare-dashboard>

# =============================================================================
# Worker API Key (Postback Authentication)
# =============================================================================
# This MUST match the WORKER_API_KEY in restate-worker
WORKER_API_KEY=<get-from-cloudflare-dashboard>

# =============================================================================
# Restate Configuration
# =============================================================================
# API key for Restate Cloud (if using cloud version)
RESTATE_API_KEY=<get-from-cloudflare-dashboard>

# =============================================================================
# Necto/Temporal API (Legacy)
# =============================================================================
TEMPORAL_API_KEY=<get-from-cloudflare-dashboard>

# =============================================================================
# Local Development Overrides
# =============================================================================
# These override the values in wrangler.jsonc for local dev
NECTO_API_URL=http://127.0.0.1:5020
RESTATE_INGRESS_URL=http://localhost:8080
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
