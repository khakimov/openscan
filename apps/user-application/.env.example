# User Application Environment Variables

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=file:./local.db

# =============================================================================
# Authentication (Better Auth)
# =============================================================================
BETTER_AUTH_SECRET=your-auth-secret-here
# Server URL - also used as APP_URL for constructing callback URLs
# Example: http://localhost:3000 → http://localhost:3000/api/internal/scan-results
BETTER_AUTH_URL=http://localhost:3000

# Alternative: Explicit APP_URL (optional, defaults to BETTER_AUTH_URL)
# Used by port-scan-service to build callback URLs for worker postbacks
# APP_URL=http://localhost:3000

# =============================================================================
# Worker Authentication
# =============================================================================
# API key for authenticating postback requests from restate-worker
# This MUST match the WORKER_API_KEY in your restate-worker .env
# Generate with: openssl rand -base64 32
# SECURITY: Keep this secret and rotate regularly (e.g., every 90 days)
# SECURITY: Use managed secrets (AWS Secrets Manager, HashiCorp Vault, etc.) in production
WORKER_API_KEY=your-secret-api-key-here

# =============================================================================
# Restate Configuration (Workflow Orchestration)
# =============================================================================
# Restate ingress URL - where the HTTP client sends workflow requests
# Local development (with Restate running locally):
RESTATE_INGRESS_URL=http://localhost:8080

# Production (Restate Cloud):
# RESTATE_INGRESS_URL=https://your-env.api.restate.run

# =============================================================================
# Legacy: Temporal Configuration (deprecated, migrating to Restate)
# =============================================================================
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
