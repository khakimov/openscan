# Temporal Connection
# For local development with Temporal running locally
TEMPORAL_SERVER_ADDRESS=localhost:7233

# For production connecting to your self-hosted server
# TEMPORAL_SERVER_ADDRESS=necto.sec.rocks:7233

TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=scanner-tasks

# Development Mode (returns mock data without running actual tools)
# Set to "true" to enable, comment out or set to "false" to disable
SCANNER_DEV_MODE=true
SCANNER_DEV_SLEEP_SECONDS=3

# Node Environment
NODE_ENV=development

# Worker Performance (optional - uses sensible defaults if not set)
# MAX_CONCURRENT_ACTIVITIES=20
# MAX_CONCURRENT_WORKFLOWS=100
# MAX_CACHED_WORKFLOWS=100

# Workflow Timeouts (optional - uses defaults if not set)
# WORKFLOW_RUN_TIMEOUT=1 hour
# WORKFLOW_EXECUTION_TIMEOUT=1 hour
# WORKFLOW_TASK_TIMEOUT=2 minutes

# Debug Mode (optional - defaults to true in development)
# DEBUG_MODE=true
